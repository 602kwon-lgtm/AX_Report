# ─────────────────────────────────────────────
#  환경변수 예시 파일 (.env.example)
#  실제 키가 든 .env / .env.txt 는 절대 커밋하지 마세요.
#  Render 배포 시: 대시보드 > Environment 에 아래 값을 등록합니다.
# ─────────────────────────────────────────────

# Anthropic API 키 (AI 기능용) — console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 Claude 모델 (선택 — 미설정 시 claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

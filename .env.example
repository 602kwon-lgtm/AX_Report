# ─────────────────────────────────────────────
#  환경변수 예시 파일 (.env.example)
#  실제 키가 든 .env / .env.txt 는 절대 커밋하지 마세요.
#  Render 배포 시: 대시보드 > Environment 에 아래 값을 등록합니다.
# ─────────────────────────────────────────────

# Anthropic API 키 (AI 기능용) — console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 사용할 Claude 모델 (선택 — 미설정 시 claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# 관리자 비밀번호 — 텍스트 편집 / AI 기능 / 수동 동기화 잠금 해제용
password=원하는_비밀번호

# 공공데이터포털 「과학기술정보통신부_사업공고」 API 키
# https://www.data.go.kr/data/15074634/openapi.do 활용신청 후 발급
DATA_GO_KR_SERVICE_KEY=발급받은_키
